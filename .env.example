# IELTSdua — Environment Variables
# Copy to .env and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# OpenRouter AI Essay & Speaking Evaluation (required for AI features)
# Get your key from https://openrouter.ai/keys
# In Cloudflare Pages: add as a secret environment variable named OPENROUTERKEY
# In local .env: use VITE_OPENROUTER_KEY (Vite must prefix with VITE_)
VITE_OPENROUTER_KEY=sk-or-...
